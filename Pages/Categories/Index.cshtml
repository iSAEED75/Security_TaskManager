@page
@model TasksWebApp.Pages.Categories.IndexModel
@{ ViewData["Title"] = "دسته‌بندی فعالیت‌ها"; }
<h1 class="h3 page-heading mb-3">مدیریت دسته‌بندی فعالیت‌ها</h1>
@if (TempData["Message"] != null) { <div class="alert alert-info">@TempData["Message"]</div> }
<form method="post" asp-page-handler="Create" class="card card-body mb-3"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-2 align-items-end"><div class="col-md-4"><label asp-for="Input.Name" class="form-label">نام دسته‌بندی</label><input asp-for="Input.Name" required class="form-control" placeholder="مثلاً: امور روزانه" /></div><div class="col-md-6"><label asp-for="Input.Description" class="form-label">توضیحات</label><input asp-for="Input.Description" class="form-control" placeholder="شرح کوتاه دسته‌بندی" /></div><div class="col-md-2"><button class="btn btn-primary w-100" type="submit">افزودن</button></div></div></form>
<div class="table-responsive card"><table class="table table-hover align-middle mb-0"><thead><tr><th>نام دسته‌بندی</th><th>توضیحات</th><th>تعداد گزارش‌ها</th><th>عملیات</th></tr></thead><tbody>@if (Model.Categories.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">هنوز دسته‌بندی‌ای ثبت نشده است.</td></tr> } @foreach (var c in Model.Categories) { <tr><td>@c.Name</td><td>@c.Description</td><td>@c.Tasks.Count</td><td><form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" onsubmit="return confirm('این دسته‌بندی حذف شود؟')"><button class="btn btn-sm btn-outline-danger" type="submit">حذف</button></form></td></tr>}</tbody></table></div>
