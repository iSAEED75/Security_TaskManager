@page
@model TasksWebApp.Pages.Reports.IndexModel
@{ ViewData["Title"] = "گزارش‌های آماری"; }
<h1 class="h3 page-heading mb-1">گزارش‌های آماری کار</h1><p class="text-muted mb-3">آمار گزارش‌ها و وظایف ثبت‌شده در بازه زمانی انتخابی.</p>
<form method="get" class="card card-body mb-3"><div class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">از تاریخ فعالیت</label><input type="text" name="FromShamsi" value="@Model.FromShamsi" placeholder="۱۴۰۵/۰۱/۰۱" inputmode="numeric" dir="ltr" class="form-control" /></div><div class="col-md-4"><label class="form-label">تا تاریخ فعالیت</label><input type="text" name="ToShamsi" value="@Model.ToShamsi" placeholder="۱۴۰۵/۰۱/۳۱" inputmode="numeric" dir="ltr" class="form-control" /></div><div class="col-md-auto"><button class="btn btn-secondary" type="submit">اعمال بازه</button></div><div class="col-md-auto"><a class="btn btn-success" asp-page-handler="ExportToExcel" asp-route-FromShamsi="@Model.FromShamsi" asp-route-ToShamsi="@Model.ToShamsi"><i class="bi bi-file-earmark-excel ms-1"></i> دریافت فایل اکسل</a></div></div></form>
<div class="row g-3 mb-3"><div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted">تعداد کل ثبت‌ها</div><strong class="fs-2">@Model.Total</strong></div></div><div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted">مجموع ساعات کار</div><strong class="fs-2">@Model.TotalHours.ToString("0.##") <small class="fs-6">ساعت</small></strong></div></div><div class="col-md-4"><div class="card p-3 h-100"><div class="text-muted">میانگین زمان هر ثبت</div><strong class="fs-2">@(Model.Total == 0 ? "۰" : (Model.TotalHours / Model.Total).ToString("0.##")) <small class="fs-6">ساعت</small></strong></div></div></div>
<div class="row g-3"><div class="col-lg-4"><div class="card p-3 h-100"><h2 class="h6">گزارش‌ها بر اساس وضعیت پیگیری</h2>@foreach (var x in Model.StatusCounts) { <div class="d-flex justify-content-between border-bottom py-2"><span>@x.Key</span><strong>@x.Value</strong></div> }</div></div><div class="col-lg-4"><div class="card p-3 h-100"><h2 class="h6">گزارش‌ها بر اساس اهمیت</h2>@foreach (var x in Model.PriorityCounts) { <div class="d-flex justify-content-between border-bottom py-2"><span>@x.Key</span><strong>@x.Value</strong></div> }</div></div><div class="col-lg-4"><div class="card p-3 h-100"><h2 class="h6">گزارش‌ها بر اساس دسته‌بندی</h2>@if (Model.CategoryCounts.Count == 0) { <p class="text-muted">داده‌ای برای نمایش وجود ندارد.</p> } @foreach (var x in Model.CategoryCounts) { <div class="d-flex justify-content-between border-bottom py-2"><span>@x.Name</span><strong>@x.Count</strong></div> }</div></div></div>
