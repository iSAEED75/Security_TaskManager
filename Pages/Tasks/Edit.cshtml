@page
@model TasksWebApp.Pages.Tasks.EditModel
@using TasksWebApp.Models
@{ ViewData["Title"] = "ویرایش گزارش یا وظیفه"; }
<div class="row justify-content-center"><div class="col-lg-9"><div class="card p-4 p-md-5">
    <div class="d-flex align-items-center gap-3 mb-4"><i class="bi bi-pencil-square fs-2 text-primary"></i><div><h1 class="h3 page-heading mb-1">ویرایش گزارش یا وظیفه</h1><p class="text-muted mb-0">اطلاعات را اصلاح و ذخیره کنید.</p></div></div>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <form method="post"><input type="hidden" asp-for="Item.Id" />
        <fieldset class="mb-4"><legend class="form-label fw-bold">نوع ثبت</legend><div class="row g-3">
            <div class="col-md-6"><label class="border rounded-3 p-3 d-flex gap-2 align-items-start h-100 w-100"><input asp-for="Item.RecordType" type="radio" value="WorkReport" class="form-check-input mt-1" /><span><strong>ثبت گزارش کار</strong><span class="d-block small text-muted">فعالیت انجام‌شده</span></span></label></div>
            <div class="col-md-6"><label class="border rounded-3 p-3 d-flex gap-2 align-items-start h-100 w-100"><input asp-for="Item.RecordType" type="radio" value="Todo" class="form-check-input mt-1" /><span><strong>ثبت وظیفه برای انجام دادن</strong><span class="d-block small text-muted">کاری که باید انجام شود</span></span></label></div>
        </div><span asp-validation-for="Item.RecordType" class="text-danger"></span></fieldset>
        <div class="mb-3"><label asp-for="Item.Title" class="form-label">عنوان</label><input asp-for="Item.Title" class="form-control" maxlength="200" required /><span asp-validation-for="Item.Title" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Item.Description" class="form-label">شرح فعالیت یا وظیفه</label><textarea asp-for="Item.Description" class="form-control" rows="6" maxlength="2000"></textarea><span asp-validation-for="Item.Description" class="text-danger"></span></div>
        <div class="row g-3"><div class="col-md-4"><label asp-for="WorkDateShamsi" class="form-label">تاریخ (شمسی)</label><input asp-for="WorkDateShamsi" class="form-control" placeholder="۱۴۰۵/۰۱/۰۱" inputmode="numeric" dir="ltr" autocomplete="off" required /><span asp-validation-for="WorkDateShamsi" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Item.DurationHours" class="form-label">مدت / زمان پیش‌بینی‌شده (ساعت)</label><input asp-for="Item.DurationHours" type="number" min="0.25" max="24" step="0.25" class="form-control" required /><span asp-validation-for="Item.DurationHours" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="Item.CategoryId" class="form-label">دسته‌بندی</label><select asp-for="Item.CategoryId" asp-items="Model.Categories" class="form-select"><option value="">بدون دسته‌بندی</option></select></div>
        <div class="col-md-6"><label asp-for="Item.Status" class="form-label">وضعیت</label><select asp-for="Item.Status" class="form-select"><option value="0">ثبت‌شده / در انتظار انجام</option><option value="1">در حال انجام / پیگیری</option><option value="2">انجام‌شده / پایان‌یافته</option></select></div>
        <div class="col-md-6"><label asp-for="Item.Priority" class="form-label">اولویت</label><select asp-for="Item.Priority" class="form-select"><option value="0">کم</option><option value="1">معمولی</option><option value="2">زیاد</option><option value="3">بسیار مهم</option></select></div></div>
        <div class="row g-3 mt-1">
            <div class="col-md-6"><label asp-for="Item.TaskListId" class="form-label">فهرست وظایف</label><select asp-for="Item.TaskListId" asp-items="Model.TaskLists" class="form-select"><option value="">بدون فهرست</option></select></div>
            <div class="col-md-6"><label asp-for="Item.AssignedToId" class="form-label">مسئول انجام وظیفه</label><select asp-for="Item.AssignedToId" asp-items="Model.Employees" class="form-select"><option value="">بدون مسئول مشخص</option></select></div>
            <div class="col-md-6"><label asp-for="Item.ParentTaskId" class="form-label">زیرمجموعه وظیفه</label><select asp-for="Item.ParentTaskId" asp-items="Model.ParentTasks" class="form-select"><option value="">وظیفه اصلی / بدون والد</option></select></div>
            <div class="col-md-6"><label asp-for="Item.RecurrenceType" class="form-label">تکرار وظیفه</label><select asp-for="Item.RecurrenceType" class="form-select"><option value="0">بدون تکرار</option><option value="1">هر روز</option><option value="2">هر هفته</option><option value="3">هر ماه</option><option value="4">هر سال</option></select></div>
            <div class="col-md-4"><label class="form-label" asp-for="ReminderDateShamsi">تاریخ یادآوری (شمسی)</label><input asp-for="ReminderDateShamsi" class="form-control" placeholder="۱۴۰۵/۰۱/۰۱" dir="ltr" inputmode="numeric" /><span asp-validation-for="ReminderDateShamsi" class="text-danger"></span></div>
            <div class="col-md-4"><label class="form-label" asp-for="ReminderTime">ساعت یادآوری</label><input asp-for="ReminderTime" type="time" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Item.SortOrder" class="form-label">ترتیب نمایش</label><input asp-for="Item.SortOrder" type="number" class="form-control" /></div>
            <div class="col-12"><div class="form-check"><input asp-for="Item.IsStarred" class="form-check-input" /><label asp-for="Item.IsStarred" class="form-check-label">علامت‌گذاری به‌عنوان وظیفه مهم ★</label></div></div>
        </div>
        <div class="d-flex gap-2 mt-4"><button class="btn btn-primary px-4" type="submit">ذخیره تغییرات</button><a asp-page="Index" class="btn btn-outline-secondary">بازگشت</a></div>
    </form>
</div></div></div>
