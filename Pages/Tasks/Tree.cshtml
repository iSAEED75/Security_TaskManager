@page
@model TasksWebApp.Pages.Tasks.TreeModel
@using TasksWebApp.Models
@using TaskStatus = TasksWebApp.Models.TaskStatus
@using TasksWebApp.Helpers
@{
    ViewData["Title"] = "نمای درختی وظایف";
    string StatusLabel(TaskStatus status) => status switch { TaskStatus.Pending => "در انتظار انجام", TaskStatus.InProgress => "در حال انجام", TaskStatus.Completed => "انجام‌شده", _ => "نامشخص" };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div><h1 class="h3 page-heading mb-1"><i class="bi bi-diagram-3 ms-2"></i>نمای درختی وظایف</h1><p class="text-muted mb-0">برای باز و بسته کردن زیر‌وظایف، عنوان هر شاخه را انتخاب کنید. برای دیدن جزئیات روی «جزئیات» بزنید.</p></div>
    <div class="d-flex gap-2"><a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-list-ul ms-1"></i>نمای جدولی</a><a asp-page="Create" class="btn btn-primary"><i class="bi bi-plus-lg ms-1"></i>ثبت مورد جدید</a></div>
</div>
@if (Model.Roots.Count == 0)
{
    <div class="card card-body text-center text-muted py-5"><i class="bi bi-diagram-3 fs-1 mb-2"></i>وظیفه‌ای برای نمایش وجود ندارد.</div>
}
else
{
    <div class="card card-body task-tree">
        @foreach (var root in Model.Roots)
        {
            <partial name="_TreeNode" model="root" />
        }
    </div>
}
