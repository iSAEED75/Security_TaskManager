@page
@model TasksWebApp.Pages.Admin.UsersModel
@{ ViewData["Title"] = "مدیریت کاربران"; }
<h1 class="h4 mb-3">مدیریت کاربران و بازنشانی گذرواژه</h1>
@if (TempData["AdminError"] is string adminError) { <div class="alert alert-danger">@adminError</div> }
@if (TempData["OneTimePassword"] is string temporaryPassword)
{
    <div class="alert alert-warning" role="alert">
        <h2 class="h6">گذرواژه موقت — فقط همین بار نمایش داده می‌شود</h2>
        <p class="mb-2">حساب: <strong>@TempData["OneTimePasswordFor"]</strong>. این مقدار گذرواژه فعلی نیست؛ گذرواژه موقت تازه‌ای است که باید به کاربر از مسیر امن تحویل داده شود.</p>
        <div class="d-flex flex-wrap align-items-center gap-2"><code id="tempPassword" class="fs-5 user-select-all">@temporaryPassword</code><button type="button" class="btn btn-sm btn-outline-dark" onclick="navigator.clipboard.writeText(document.getElementById('tempPassword').innerText)">کپی گذرواژه موقت</button></div>
        <p class="small mb-0 mt-2">پس از ورود، تغییر گذرواژه اجباری است. این صفحه را ببند یا دوباره بارگذاری نکن تا مقدار موقت از دست نرود.</p>
    </div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<section class="card p-4 mb-4">
    <h2 class="h5 mb-3">ایجاد حساب کاربری</h2>
    <form method="post" asp-page-handler="Create" class="row g-3">
        <div class="col-md-6"><label asp-for="FullName" class="form-label">نام و نام خانوادگی</label><input asp-for="FullName" class="form-control" maxlength="150" required /><span asp-validation-for="FullName" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Username" class="form-label">نام کاربری</label><input asp-for="Username" class="form-control" maxlength="100" required autocomplete="off" /><span asp-validation-for="Username" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="EmployeeNumber" class="form-label">شماره پرسنلی</label><input asp-for="EmployeeNumber" class="form-control" maxlength="50" required /><span asp-validation-for="EmployeeNumber" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="Role" class="form-label">نقش</label><select asp-for="Role" class="form-select"><option value="User">کاربر عادی</option><option value="Admin">مدیر سامانه</option></select></div>
        <div class="col-12"><p class="form-text">سامانه یک گذرواژه موقت تصادفی تولید می‌کند؛ کاربر ناچار است در اولین ورود آن را تغییر دهد.</p><button class="btn btn-primary" type="submit">ایجاد حساب</button></div>
    </form>
</section>
<section class="card p-3">
    <h2 class="h5 mb-3">حساب‌های ثبت‌شده</h2>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>نام</th><th>نام کاربری</th><th>شماره پرسنلی</th><th>نقش</th><th>آخرین ورود</th><th>وضعیت گذرواژه</th><th>عملیات</th></tr></thead><tbody>
    @foreach (var item in Model.Users)
    {
        <tr><td>@item.FullName</td><td>@item.Username</td><td>@item.EmployeeNumber</td><td>@(item.Role == "Admin" ? "مدیر سامانه" : "کاربر عادی")</td><td>@(item.LastLoginAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "ثبت نشده")</td><td>@(item.MustChangePassword ? "تغییر در ورود بعدی الزامی" : "عادی")</td><td><form method="post" asp-page-handler="ResetPassword" onsubmit="return confirm('برای این حساب گذرواژه موقت تازه تولید و همه نشست‌های آن خاتمه داده شود؟');"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">بازنشانی گذرواژه</button></form></td></tr>
    }
    </tbody></table></div>
</section>
