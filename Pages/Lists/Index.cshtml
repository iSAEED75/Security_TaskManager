@page
@model TasksWebApp.Pages.Lists.IndexModel
@{ ViewData["Title"] = "فهرست‌های وظایف"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 page-heading mb-1">فهرست‌های وظایف</h1><p class="text-muted mb-0">وظایف را در فهرست‌های جداگانه مثل امور اداری، پروژه‌ها و کارهای روزانه سازمان‌دهی کنید.</p></div><a class="btn btn-outline-secondary" asp-page="/Tasks/Index">بازگشت به صفحه اصلی</a></div>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<form method="post" asp-page-handler="Create" class="card card-body mb-3"><label asp-for="Name" class="form-label">نام فهرست جدید</label><div class="input-group"><input asp-for="Name" class="form-control" maxlength="100" placeholder="مثلاً: امور اداری"/><button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg ms-1"></i> ایجاد فهرست</button></div><span asp-validation-for="Name" class="text-danger"></span></form>
<div class="row g-3">@if (Model.Items.Count == 0) { <div class="col-12"><div class="card p-4 text-center text-muted">هنوز فهرستی ایجاد نشده است.</div></div> } @foreach (var item in Model.Items) { <div class="col-md-6 col-lg-4"><div class="card p-3 h-100"><div class="d-flex justify-content-between align-items-start"><div><i class="bi bi-folder2-open fs-3 text-primary"></i><h2 class="h5 mt-2">@item.List.Name</h2><div class="text-muted small">@item.Count وظیفه یا گزارش</div></div>@if (item.List.Name != "کارهای من") { <form method="post" asp-page-handler="Delete" asp-route-id="@item.List.Id" onsubmit="return confirm('فهرست حذف شود؟ وظایف باقی می‌مانند و فقط از این فهرست جدا می‌شوند.')"><button class="btn btn-sm btn-outline-danger" type="submit" title="حذف فهرست"><i class="bi bi-trash"></i></button></form> }</div><a class="btn btn-sm btn-outline-primary mt-3 align-self-start" asp-page="/Tasks/Index" asp-route-TaskListId="@item.List.Id">مشاهده موارد این فهرست</a></div></div> }</div>
