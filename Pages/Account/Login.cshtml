@page
@model TasksWebApp.Pages.Account.LoginModel
@{ ViewData["Title"]="ورود"; }
<div class="row justify-content-center"><div class="col-md-5"><div class="card p-4 mt-5"><h3 class="mb-3">ورود به سامانه</h3>@if (TempData["PasswordChangedMessage"] is string passwordMessage) { <div class="alert alert-success" role="status">@passwordMessage</div> }<div asp-validation-summary="All" class="text-danger"></div><form method="post"><div class="mb-3"><label asp-for="Username" class="form-label">نام کاربری</label><input asp-for="Username" class="form-control" autocomplete="username"/></div><div class="mb-3"><label asp-for="Password" class="form-label">گذرواژه</label><input asp-for="Password" class="form-control" type="password" autocomplete="current-password"/></div><div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label">مرا به خاطر بسپار</label></div><button class="btn btn-primary w-100">ورود</button></form><a class="mt-3" asp-page="Register">ثبت‌نام کاربر</a></div></div></div>