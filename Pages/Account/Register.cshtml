@page
@model TasksWebApp.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "ثبت‌نام";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">
            <h3>ثبت‌نام کاربر</h3>
            <div asp-validation-summary="All" class="text-danger"></div>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">نام و نام خانوادگی</label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="EmployeeNumber" class="form-label">شماره پرسنلی</label>
                    <input asp-for="EmployeeNumber" class="form-control" required />
                    <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">نام کاربری</label>
                    <input asp-for="Username" class="form-control" autocomplete="username" required />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">گذرواژه</label>
                    <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" required minlength="8" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">تکرار گذرواژه</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button class="btn btn-primary" type="submit">ثبت‌نام</button>
                <a asp-page="Login" class="btn btn-link">بازگشت به ورود</a>
            </form>
        </div>
    </div>
</div>
